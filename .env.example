# WebSocket Configuration
# Enable WebSocket server in development (disabled by default to avoid HMR conflicts)
ENABLE_WEBSOCKET=false

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/townkart"

# NextAuth
NEXTAUTH_SECRET="your-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Razorpay Payment Gateway
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# Email Service (Resend)
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="noreply@townkart.com"
RESEND_FROM_NAME="TownKart"

# SMS Service (MSG91)
MSG91_API_KEY="your-msg91-api-key"
MSG91_SENDER_ID="TOWNKT"
MSG91_ROUTE="4"
MSG91_DLT_TEMPLATE_ID="your-dlt-template-id"

# WhatsApp (MSG91)
MSG91_WHATSAPP_AUTH_KEY="your-whatsapp-auth-key"
MSG91_WHATSAPP_INTEGRATED_NUMBER="your-integrated-number"
MSG91_WHATSAPP_NAMESPACE="your-namespace"

# JWT
JWT_SECRET="your-jwt-secret"
JWT_REFRESH_SECRET="your-jwt-refresh-secret"

# Redis (optional, for rate limiting)
REDIS_URL="redis://localhost:6379"