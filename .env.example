NEXT_PUBLIC_WS_URL= WebSocket server URL for real-time updates - Example: ws://localhost:3001
DATABASE_URL=  PostgreSQL database connection string - Example: postgresql://user:password@localhost:5432/townkart
NEXTAUTH_SECRET=  NextAuth.js secret key - Example: your-secret-key-here
NEXTAUTH_URL=  NextAuth.js base URL - Example: http://localhost:3000
RAZORPAY_KEY_ID=  Razorpay payment gateway key ID - Example: rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=  Razorpay payment gateway secret - Example: xxxxxxxxxxxxxxxxxxxx
SMS_API_KEY= SMS service API key for OTP - Example: your-sms-api-key
EMAIL_API_KEY= Email service API key for notifications - Example: your-email-api-key
GOOGLE_MAPS_API_KEY= Google Maps API key for location services - Example: your-google-maps-key
CLOUDINARY_CLOUD_NAME= Cloudinary cloud name for image uploads - Example: your-cloud-name
CLOUDINARY_API_KEY=  Cloudinary API key - Example: your-cloudinary-key
CLOUDINARY_API_SECRET=  Cloudinary API secret - Example: your-cloudinary-secret
REDIS_URL=  Redis connection URL for caching - Example: redis://localhost:6379
JWT_SECRET=  JWT signing secret - Example: your-jwt-secret
STRIPE_PUBLISHABLE_KEY=  Stripe publishable key (if using Stripe) - Example: pk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY=  Stripe secret key - Example: sk_test_xxxxxxxxxxxx
FIREBASE_PROJECT_ID=  Firebase project ID for notifications - Example: your-project-id
FIREBASE_PRIVATE_KEY= Firebase private key - Example: -----BEGIN PRIVATE KEY-----\n...
FIREBASE_CLIENT_EMAIL=  Firebase client email - Example: firebase-adminsdk@project.iam.gserviceaccount.com
AWS_ACCESS_KEY_ID=  AWS access key for S3 storage - Example: AKIAxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=  AWS secret key - Example: xxxxxxxxxxxxxxxxxxxx
AWS_REGION=  AWS region - Example: us-east-1
S3_BUCKET_NAME=  S3 bucket name for file storage - Example: your-bucket-name
TWILIO_ACCOUNT_SID=  Twilio account SID for SMS - Example: ACxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=  Twilio auth token - Example: your-twilio-token
TWILIO_PHONE_NUMBER=  Twilio phone number - Example: +1234567890
SENDGRID_API_KEY=  SendGrid API key for emails - Example: SG.xxxxxxxxxxxxxxxxxxxx
MONGODB_URI=  MongoDB connection string (if using) - Example: mongodb://localhost:27017/townkart
ELASTICSEARCH_URL=  Elasticsearch URL for search - Example: http://localhost:9200
KAFKA_BROKERS=  Kafka brokers for event streaming - Example: localhost:9092
PROMETHEUS_URL= Prometheus server URL for monitoring - Example: http://localhost:9090
GRAFANA_URL=  Grafana dashboard URL - Example: http://localhost:3001