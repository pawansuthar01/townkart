model Offer {
  id            String   @id @default(cuid())
  title         String
  description   String?
  type          OfferType @default(PERCENTAGE_DISCOUNT)

  // Discount details
  discountValue Float    // Percentage (0-100) or fixed amount
  maxDiscount   Float?   // Maximum discount amount for percentage offers
  minOrderValue Float    @default(0) // Minimum order value to apply offer

  // Validity
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(true)

  // Applicability
  applicableTo  OfferApplicability @default(ALL_PRODUCTS)
  productIds    Json?    // Array of specific product IDs
  categoryIds   Json?    // Array of specific category IDs
  merchantIds   Json?    // Array of specific merchant IDs

  // User targeting
  targetUsers   OfferTarget @default(ALL_USERS)
  userIds       Json?    // Array of specific user IDs for personalized offers
  userSegments  Json?    // User segments (new_users, loyal_customers, etc.)

  // Usage limits
  usageLimit    Int?     // Total usage limit
  perUserLimit  Int      @default(1) // Usage limit per user
  usedCount     Int      @default(0)

  // Coupon code (optional)
  couponCode    String?  @unique
  isAutoApply   Boolean  @default(false)

  // Metadata
  createdBy     String   // Admin/Merchant ID who created
  priority      Int      @default(0) // For multiple offers on same product
  terms         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  orders        Order[]

  @@map("offers")
}

model Collection {
