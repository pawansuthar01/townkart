// Support Ticket System
enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportTicketCategory {
  ORDERS
  PAYMENT
  DELIVERY
  ACCOUNT
  TECHNICAL
  REFUND
  OTHER
}

model SupportTicket {
  id            String   @id @default(cuid())
  ticketNumber  String   @unique @default(cuid()) // Human-readable ticket number
  customerId    String
  customer      User     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Ticket details
  subject       String
  description   String
  category      SupportTicketCategory @default(OTHER)
  priority      SupportTicketPriority @default(MEDIUM)
  status        SupportTicketStatus @default(OPEN)

  // Related entities
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id])
  storeId       String?
  store         Store?   @relation(fields: [storeId], references: [id])

  // Assignment
  assignedTo    String?  // Admin/Support agent ID
  assignedAt    DateTime?

  // Resolution
  resolution    String?
  resolvedAt    DateTime?
  resolvedBy    String?  // Admin/Support agent ID

  // Metadata
  source        String   @default("web") // web, mobile, email, phone
  tags          Json?    // Array of tags for categorization
  attachments   Json?    // Array of file URLs

  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastReplyAt   DateTime @default(now())

  // Relations
  messages      SupportMessage[]

  @@index([customerId, status])
  @@index([status, priority])
  @@index([assignedTo])
  @@map("support_tickets")
}

model SupportMessage {
  id            String   @id @default(cuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Message details
  senderId      String   // User ID who sent the message
  senderType    String   @default("customer") // customer, admin, system
  message       String
  isInternal    Boolean  @default(false) // Internal notes not visible to customer

  // Attachments
  attachments   Json?    // Array of file URLs

  // Metadata
  readAt        DateTime?
  sentAt        DateTime @default(now())

  @@index([ticketId, sentAt])
  @@map("support_messages")
}

// Invitation System for Controlled Registration
enum InvitationType {
  ADMIN_TO_RIDER
  ADMIN_TO_STORE
  RIDER_TO_STORE
}

enum InvitationStatus {
  PENDING
  APPROVED
  REJECTED
  USED
  EXPIRED
}

model Invitation {
  id              String           @id @default(cuid())
  invitedBy       String           // User ID who sent the invitation
  invitedByUser   User             @relation("SentInvitations", fields: [invitedBy], references: [id])
  invitedEmail    String
  invitedPhone    String?
  role            UserRole         // RIDER or STORE_MANAGER
  invitationType  InvitationType
  status          InvitationStatus @default(PENDING)
  token           String           @unique // Unique invitation token
  expiresAt       DateTime
  usedAt          DateTime?
  usedBy          String?          // User ID who used the invitation
  usedByUser      User?            @relation("UsedInvitations", fields: [usedBy], references: [id])
  message         String?          // Optional message from inviter
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("invitations")
}

// System Settings for Platform Management
model SystemSetting {
  id          String   @id @default(cuid())
  category    String   // e.g., "platform", "payment", "delivery", "security"
  key         String   // Setting key within category
  value       String   // JSON string of the setting value
  description String?  // Human-readable description
  isPublic    Boolean  @default(false) // Whether setting is visible to non-admin users
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([category, key])
  @@map("system_settings")
}