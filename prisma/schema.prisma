// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
 
}

enum UserRole {
  CUSTOMER
  STORE_MANAGER
  RIDER
  ADMIN
}

enum StoreApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  ORDER_PLACED
  STORE_ASSIGNED
  BEING_PREPARED
  READY_FOR_PICKUP
  RIDER_ASSIGNED
  EN_ROUTE
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  UPI
  CARD
  WALLET
  NET_BANKING
}

enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum NotificationType {
  ORDER_CREATED
  ORDER_ACCEPTED
  ORDER_READY
  DELIVERY_ASSIGNED
  DELIVERY_PICKED_UP
  DELIVERY_OUT
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  GENERAL
  SYSTEM_NOTIFICATION
  LOGIN_ALERT
  DEVICE_CHANGE
  SECURITY_ALERT
}

enum TransactionType {
  CREDIT
  DEBIT
}

model User {
  id                String   @id @default(cuid())
  phoneNumber       String   @unique
  fullName          String?
  email             String?  @unique
  password          String?
  userRoles         UserRole[]
  activeRole        UserRole @default(CUSTOMER)
  profileImageUrl   String?
  emailVerified     Boolean  @default(false)
  phoneVerified     Boolean  @default(false)
  isActive          Boolean  @default(true)
  lastLoginAt       DateTime?
  lastLoginIP       String?
  lastLoginDevice   String?

  // Registration location for validation
  registrationIP    String?
  registrationLocation Json? // {country, city, region, lat, lng}

  // Notification preferences (global)
  emailNotifications Boolean @default(true)
  pushNotifications  Boolean @default(true)
  smsNotifications   Boolean @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  customerProfile   CustomerProfile?
  riderProfile      RiderProfile?
  managedStores     Store[]          @relation("StoreManager")
  storeStaff        StoreStaff[]
  addresses         Address[]
  orders            Order[]
  reviews           Review[]
  productReviews    ProductReview[]
  notifications     Notification[]
  wallet            Wallet?
  couponUsages      CouponUsage[]
  productSales      ProductSales[]
  sessions          Session[]
  devices           Device[]
  deviceLoginLogs   DeviceLoginLog[]
  loginAttempts     LoginAttempt[]
  emailVerifications EmailVerification[]
  phoneVerifications PhoneVerification[]
  wishlistItems     WishlistItem[]
  customerDisputes  Dispute[]        @relation("CustomerDisputes")
  riderDisputes     Dispute[]        @relation("RiderDisputes")
  locationConsents  LocationConsent[]
  locationDataRecords LocationDataRecord[]
  locationAuditLogs LocationAuditLog[]
  supportTickets    SupportTicket[]
  sentInvitations   Invitation[]    @relation("SentInvitations")
  usedInvitations   Invitation[]    @relation("UsedInvitations")

  @@map("users")
}

model CustomerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences Json?    // Store user preferences as JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("customer_profiles")
}

model Store {
  id                String   @id @default(cuid())
  name              String
  code              String   @unique // Store code for identification
  description       String?
  address           String
  city              String   // City for multi-city support
  state             String
  pincode           String
  latitude          Float
  longitude         Float
  category          String
  subcategory       String?

  // Store Management
  managerId         String?  // Store manager user ID
  manager           User?    @relation("StoreManager", fields: [managerId], references: [id])

  // Operating Hours (JSON)
  operatingHours    Json?    // {monday: {open: "09:00", close: "21:00"}, ...}

  // Status & Verification
   isActive          Boolean  @default(true)
   isVerified        Boolean  @default(false)
   applicationStatus StoreApplicationStatus @default(PENDING)

  // Performance Metrics
  averageRating     Float    @default(0)
  totalOrders       Int      @default(0)
  totalRevenue      Float    @default(0)

  // Contact
  phoneNumber       String?
  email             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  orders            Order[]
  inventory         StoreInventory[]
  staff             StoreStaff[]
  disputes          Dispute[]
  cashTransactions  CashTransaction[]
  cashSettlements   CashSettlement[]
  reviews           Review[]
  productSales      ProductSales[]
  serviceArea       ServiceArea @relation(fields: [serviceAreaId], references: [id])
  serviceAreaId     String
  riderAssignments  RiderStoreAssignment[]
  collections       StoreCollection[]
  supportTickets    SupportTicket[]

  @@map("stores")
}

model RiderProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Basic Info
  vehicleType     String   @default("bike")
  vehicleNumber   String?
  licenseNumber   String?
  emergencyContact String?
  emergencyPhone  String?

  // Availability & Location
  city            String   // Rider's operating city
  isAvailable     Boolean  @default(false)
  currentLat      Float?
  currentLng      Float?
  lastLocationUpdate DateTime?
  availabilitySchedule Json? // Weekly schedule for availability

  // Performance Metrics
  rating          Float    @default(0)
  totalDeliveries Int      @default(0)
  totalEarnings   Float    @default(0)
  onTimeDeliveryRate Float @default(0)
  averageDeliveryTime Int? // in minutes

  // Status & Verification
  isVerified      Boolean  @default(false)
  isActive        Boolean  @default(true)
  suspensionReason String?
  suspendedUntil  DateTime?

  // Admin Controls
  maxDailyDeliveries Int   @default(20)
  preferredZones   Json?   // Array of zone IDs
  skills           Json?   // Special skills (heavy items, etc.)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  deliveries      Delivery[]
  reviews         Review[]
  riderLogs       RiderLog[]
  earningsHistory RiderEarnings[]
  locationHistory RiderLocation[]
  cashTransactions CashTransaction[]
  cashSettlements CashSettlement[]
  cashBalance     RiderCashBalance?
  zoneAssignment  RiderZoneAssignment?
  storeAssignments RiderStoreAssignment[]

  @@map("rider_profiles")
}

model Address {
  id          String      @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  line1       String
  line2       String?
  landmark    String?
  city        String
  state       String
  pincode     String
  latitude    Float?
  longitude   Float?
  addressType AddressType @default(HOME)
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("addresses")
}

model Product {
  id                String   @id @default(cuid())

  // Basic Information
  name              String
  slug              String?  @unique // URL-friendly name
  description       String?
  shortDescription  String?  // Brief description for listings
  sku               String?  @unique // Stock Keeping Unit
  barcode           String?  @unique // Product barcode
  brand             String?

  // Pricing
  price             Float
  discountedPrice   Float?
  costPrice         Float?   // Merchant's cost price
  taxRate           Float    @default(0) // Tax percentage
  taxAmount         Float    @default(0)

  // Inventory
  stockQuantity     Int      @default(0)
  minStockLevel     Int      @default(0) // Reorder point
  maxStockLevel     Int?     // Maximum stock to hold
  stockStatus       String   @default("IN_STOCK") // IN_STOCK, OUT_OF_STOCK, LOW_STOCK

  // Categories & Classification
  categoryName      String
  subcategory       String?
  tags              Json?    // Array of tags for filtering
  keywords          Json?    // SEO keywords

  // Product Details
  weight            Float?   // In grams
  dimensions        Json?    // {length, width, height} in cm
  packageWeight     Float?   // Shipping weight
  packageDimensions Json?    // Shipping dimensions

  // Specifications & Attributes
  specifications    Json?    // Key-value pairs of specs
  attributes        Json?    // Product variants/attributes
  features          Json?    // Array of product features

  // Media
  imageUrls         Json?    // Array of image URLs (legacy)
  videos            Json?    // Array of video URLs
  documents         Json?    // Manuals, certificates, etc.

  // SEO & Marketing
  metaTitle         String?
  metaDescription   String?
  seoUrl            String?

  // Status & Visibility
  isAvailable       Boolean  @default(true)
  isFeatured        Boolean  @default(false)
  isNew             Boolean  @default(false)
  isOnSale          Boolean  @default(false)
  isDigital         Boolean  @default(false) // Digital product
  requiresShipping  Boolean  @default(true)

  // Sales & Analytics
  totalSales        Int      @default(0)
  totalViews        Int      @default(0)
  averageRating     Float    @default(0)
  totalReviews      Int      @default(0)

  // Timestamps
  publishedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  orderItems        OrderItem[]
  reviews           ProductReview[]
  variants          ProductVariant[]
  images            ProductImage[]
  category          ProductCategory? @relation(fields: [categoryId], references: [id])
  categoryId        String?
  sales             ProductSales[]
  wishlistItems     WishlistItem[]
  storeInventory    StoreInventory[]

  @@map("products")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique @default(cuid())
  customerId      String
  customer        User        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Changed: storeId instead of merchantId
  storeId         String
  store           Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Customer location for assignment
  customerLat     Float?
  customerLng     Float?

  // Financial
  totalAmount     Float
  deliveryFee     Float       @default(0)
  taxAmount       Float       @default(0)
  discountAmount  Float       @default(0)
  finalAmount     Float
  refundAmount    Float       @default(0)

  // Status & Flow (updated)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus @default(ORDER_PLACED)
  cancellationReason String?
  cancelledBy     String?
  cancellationFee Float       @default(0)

  // Delivery
  deliveryAddress Json        // Store address as JSON for flexibility
  deliveryInstructions String?
  deliveryPriority String     @default("normal") // normal, urgent, scheduled
  scheduledDeliveryTime DateTime?

  // Timing (updated)
  specialInstructions String?
  storeAssignedAt DateTime?
  readyAt         DateTime?
  riderAssignedAt DateTime?
  enRouteAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deliveredAt     DateTime?

  // Relations (updated)
  orderItems      OrderItem[]
  delivery        Delivery?
  payment         Payment?
  review          Review?
  productReviews  ProductReview[]
  walletTransactions WalletTransaction[]
  offers          Offer[]
  couponUsages    CouponUsage[]
  productSales    ProductSales[]
  orderLogs       OrderLog[]
  statusHistory   OrderStatusHistory[] // New
  disputes        Dispute[]
  cashTransactions CashTransaction[]
  supportTickets  SupportTicket[]

  @@map("orders")
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Variant support
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Order details
  productSnapshot   Json     // Store product data at time of order
  variantSnapshot   Json?    // Store variant data at time of order
  quantity          Int
  unitPrice         Float
  discountAmount    Float    @default(0)
  taxAmount         Float    @default(0)
  subtotal          Float

  // Item status
  status            String   @default("PENDING") // PENDING, CONFIRMED, PREPARING, READY, DELIVERED, CANCELLED

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("order_items")
}

model Delivery {
  id              String        @id @default(cuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId         String?
  rider           RiderProfile? @relation(fields: [riderId], references: [id], onDelete: Cascade)

  // Timing
  pickupTime      DateTime?
  deliveryTime    DateTime?
  estimatedPickupTime DateTime?
  estimatedDeliveryTime DateTime?

  // OTP & Verification
  pickupOtp       String        // 4-digit OTP
  deliveryOtp     String        // 4-digit OTP
  pickupOtpVerified Boolean     @default(false)
  deliveryOtpVerified Boolean   @default(false)

  // Status & Assignment
  deliveryStatus  DeliveryStatus @default(ASSIGNED)
  assignmentType  String        @default("auto") // auto, manual, preferred
  reassignedCount Int           @default(0)
  assignmentLocked Boolean      @default(false)
  assignmentLockExpiresAt DateTime?

  // Location & Distance
  pickupLat       Float?
  pickupLng       Float?
  deliveryLat     Float?
  deliveryLng     Float?
  distanceKm      Float?
  actualDistanceKm Float?

  // Financial
  deliveryFee     Float         @default(0)
  riderEarnings   Float         @default(0)
  commissionFee   Float         @default(0)

  // Media & Proof
  proofPhotoUrl   String?
  signatureUrl    String?
  customerFeedback String?

  // Quality Control
  qualityRating   Int?          // 1-5 stars from admin
  qualityNotes    String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  deliveryLogs    DeliveryLog[]
  riderLocations  RiderLocation[]
  riderEarningsRecords RiderEarnings[]
  disputes        Dispute[]
  @@map("deliveries")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount            Float
  paymentMethod     PaymentMethod
  transactionId     String?       @unique
  paymentStatus     PaymentStatus @default(PENDING)
  gatewayOrderId    String?
  gatewayPaymentId  String?
  gatewaySignature  String?
  createdAt         DateTime      @default(now())
  completedAt       DateTime?

  @@map("payments")
}

model Review {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId    String
  customer      User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  riderId       String?
  rider         RiderProfile? @relation(fields: [riderId], references: [id], onDelete: Cascade)
  storeRating   Int?    // 1-5 stars
  riderRating   Int?     // 1-5 stars
  comment       String?
  createdAt     DateTime @default(now())

  @@map("reviews")
}

model Wallet {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userType      String   // 'merchant' or 'rider'
  currentBalance Float    @default(0)
  totalEarned   Float    @default(0)
  totalWithdrawn Float    @default(0)
  lastUpdatedAt DateTime @updatedAt

  // Relations
  transactions  WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id            String          @id @default(cuid())
  walletId      String
  wallet        Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  orderId       String?
  order         Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Float
  transactionType TransactionType
  description   String
  balanceAfter  Float
  createdAt     DateTime        @default(now())

  @@map("wallet_transactions")
}

model Notification {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  message          String
  notificationType NotificationType
  referenceId      String?          // ID of related entity (order, delivery, etc.)
  isRead           Boolean          @default(false)
  priority         String           @default("medium") // low, medium, high
  createdAt        DateTime         @default(now())

  @@map("notifications")
}

model OTP {
  id                String   @id @default(cuid())
  phoneNumber       String
  otp               String
  purpose           String   // 'LOGIN', 'REGISTER', 'RESET_PASSWORD', 'PHONE_VERIFICATION', 'ACCOUNT_REACTIVATION'
  expiresAt         DateTime
  isUsed            Boolean  @default(false)

  // Delivery tracking for production monitoring
  deliveryStatus    String?  @default("PENDING") // PENDING, SENT, DELIVERED, FAILED
  deliveryAttempts  Int      @default(0)
  deliveryChannels  Json?    // Array of channels used: ["SMS", "Email"]
  deliveryResults   Json?    // Detailed delivery results with retry info
  deliveryWebhookData Json?  // Data from delivery webhooks

  createdAt         DateTime @default(now())

  @@map("otps")
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Session details
  sessionToken  String   @unique
  accessToken   String?  @unique
  refreshToken  String?  @unique

  // Device tracking
  deviceId      String?
  device        Device?  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // Session metadata
  ipAddress     String?
  userAgent     String?
  location      Json?    // {country, city, region}
  isActive      Boolean  @default(true)

  // Timestamps
  expiresAt     DateTime
  lastActivity  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("sessions")
}

model Device {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Device identification
  deviceId      String   // Unique device identifier
  deviceName    String?  // User-friendly name
  deviceType    String   // 'mobile', 'desktop', 'tablet'
  os            String?  // Operating system
  browser       String?  // Browser name
  fingerprint   String?  // Device fingerprint

  // Location tracking
  lastIP        String?
  lastLocation  Json?    // {country, city, region, lat, lng}
  registrationLocation Json? // Location where user registered

  // Trust status
  isTrusted     Boolean  @default(false)
  trustExpiresAt DateTime?

  // Activity
  lastLoginAt   DateTime?
  loginCount    Int      @default(0)
  isActive      Boolean  @default(true) // For device management

  // Battery & Status tracking
  batteryLevel  Int?     // Battery percentage (0-100)
  lastBatteryUpdate DateTime?

  // Notification preferences per device
  pushNotifications Boolean @default(true)
  emailNotifications Boolean @default(true)
  inAppNotifications Boolean @default(true)

  // Relations
  sessions      Session[]
  loginLogs     DeviceLoginLog[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, deviceId])
  @@map("devices")
}

model DeviceLoginLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId      String
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // Login details
  loginType     String   // 'LOGIN', 'LOGOUT', 'SESSION_EXPIRED', 'FORCED_LOGOUT'
  ipAddress     String
  userAgent     String?
  location      Json?    // {country, city, region, lat, lng}

  // Device status
  batteryLevel  Int?
  deviceType    String

  // Security flags
  isSuspicious  Boolean  @default(false)
  riskLevel     String   @default("LOW") // LOW, MEDIUM, HIGH
  riskReasons   Json?    // Array of risk factors

  // Location validation
  locationMatch Boolean  @default(true) // Whether login location matches registration
  distanceKm    Float?   // Distance from registration location

  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
  @@map("device_login_logs")
}

model LoginAttempt {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Attempt details
  identifier    String   // phone/email used for login
  ipAddress     String
  userAgent     String?
  location      Json?    // {country, city, region}

  // Result
  success       Boolean  @default(false)
  failureReason String?

  // Device info
  deviceId      String?
  deviceType    String?

  createdAt     DateTime @default(now())

  @@map("login_attempts")
}

model EmailVerification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  email         String
  token         String   @unique
  expiresAt     DateTime
  isUsed        Boolean  @default(false)

  // Verification purpose
  purpose       String   @default("EMAIL_VERIFICATION") // EMAIL_VERIFICATION, PASSWORD_RESET

  createdAt     DateTime @default(now())

  @@map("email_verifications")
}

model PhoneVerification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  phoneNumber   String
  otp           String
  expiresAt     DateTime
  isUsed        Boolean  @default(false)

  // Verification purpose
  purpose       String   @default("PHONE_VERIFICATION") // PHONE_VERIFICATION, PASSWORD_RESET

  createdAt     DateTime @default(now())

  @@map("phone_verifications")
}

model ProductReview {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId    String
  customer      User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId       String?  // Link to order for verification
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  rating        Int      // 1-5 stars
  title         String?
  comment       String?
  pros          Json?    // Array of positive points
  cons          Json?    // Array of negative points

  // Review metadata
  isVerified    Boolean  @default(false) // Purchased product
  isHelpful     Int      @default(0)     // Helpful votes
  isReported    Boolean  @default(false)
  reportReason  String?

  // Media
  images        Json?    // Review images
  videos        Json?    // Review videos

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("product_reviews")
}

model ProductCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  parentId    String?
  parent      ProductCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryHierarchy")
  products    Product[]
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("product_categories")
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Variant details
  name          String   // e.g., "Size: Large", "Color: Red"
  sku           String?  @unique
  barcode       String?  @unique

  // Pricing (can override base product price)
  price         Float?
  discountedPrice Float?

  // Inventory
  stockQuantity Int      @default(0)
  isAvailable   Boolean  @default(true)

  // Attributes
  attributes    Json     // {size: "L", color: "Red"}

  // Media (variant-specific images)
  images        Json?

  // Relations
  orderItems    OrderItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("product_variants")
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  url         String
  alt         String?
  caption     String?
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)
  width       Int?
  height      Int?
  fileSize    Int?     // in bytes
  createdAt   DateTime @default(now())

  @@map("product_images")
}

model ProductAttribute {
  id          String   @id @default(cuid())
  name        String   // e.g., "Color", "Size", "Material"
  values      Json     // Array of possible values
