enum CashSettlementStatus {
  PENDING
  SUBMITTED
  VERIFIED
  SETTLED
  DISPUTED
}

enum CashTransactionType {
  COLLECTED    // Rider collected cash from customer
  DEPOSITED    // Rider deposited cash at store/hub
  RETURNED     // Cash returned for failed delivery
  ADJUSTED     // Administrative adjustment
}

model CashTransaction {
  id            String   @id @default(cuid())
  riderId       String
  rider         RiderProfile @relation(fields: [riderId], references: [id])
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id])
  storeId       String?  // Store where cash was deposited
  store         Store?   @relation(fields: [storeId], references: [id])

  amount        Float    // Amount in rupees
  transactionType CashTransactionType
  status        CashSettlementStatus @default(PENDING)

  // Location & verification
  collectedLat  Float?
  collectedLng  Float?
  collectedAt   DateTime?
  depositedAt   DateTime?

  // Verification
  otpVerified   Boolean  @default(false)
  photoProofUrl String?

  // Settlement
  settlementBatchId String?
  settlementId String?
  settlement CashSettlement? @relation(fields: [settlementId], references: [id])
  settledAt     DateTime?

  // Audit
  notes         String?
  verifiedBy    String?  // Admin/store manager ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("cash_transactions")
}

model CashSettlement {
